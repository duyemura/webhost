NODE_ENV=development

# Server
PORT=3000
BASE_DOMAIN=localhost

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Database
# On macOS with Homebrew Postgres, use the socket path: /tmp
# On Linux or remote Postgres, use: localhost or the server IP
DB_HOST=/tmp
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=webhost

# File storage
FRONTEND_URL=http://localhost:5173

# Google OAuth — create credentials at https://console.cloud.google.com
# Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

SITES_DIR=./data/sites

# Production only — your hosting domain
# BASE_DOMAIN=sites.yourdomain.com
