NODE_ENV=development

# Server
PORT=3000
BASE_DOMAIN=localhost

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Database
# On macOS with Homebrew Postgres, use the socket path: /tmp
# On Linux or remote Postgres, use: localhost or the server IP
DB_HOST=/tmp
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=webhost

# File storage
FRONTEND_URL=http://localhost:5173

# Google OAuth — create credentials at https://console.cloud.google.com
# Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Anthropic — AI site generation
ANTHROPIC_API_KEY=

# Google Maps Embed — used by map-location block (optional; block shows address text if unset)
GOOGLE_MAPS_API_KEY=

# Cloudflare R2 — object storage for site files
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_KEY=
CF_R2_BUCKET=webhost-sites

# Cloudflare for SaaS — custom domain SSL provisioning
# Leave CF_API_TOKEN empty in local dev; custom domains will be stored without provisioning
CF_API_TOKEN=
CF_CNAME_TARGET=proxy.onboardagent.com

# Production only — your hosting domain
# BASE_DOMAIN=sites.yourdomain.com
